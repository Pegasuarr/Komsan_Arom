# ===================================================================
# MelodyHub (Komsan Arom) Environment Configuration
# Copy this file to .env and adjust variables as needed
# ===================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=melodyhub_db
POSTGRES_USER=melodyhub_user
POSTGRES_PASSWORD=melodyhub_password

# Spring Boot Security (JWT 256-bit base64 secret)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# Telegram Bot Integration (Optional)
# 1. Talk to @BotFather on Telegram to create your bot and copy the API token
# 2. Start a conversation with your bot or add it to a channel
# 3. Use @userinfobot to get your Telegram numerical chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=MelodyHubBot
TELEGRAM_ADMIN_CHAT_ID=

